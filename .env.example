# ===================================================================
# EWS AstroLink — Cấu hình API AI sinh nội dung HTML (Template Editor)
# ===================================================================

# 1. Điền API Key của bạn vào đây (OpenAI, DeepSeek, Groq, OpenRouter, hoặc OpenAI-compatible API)
AI_API_KEY=

# 2. Endpoint của API (Mặc định dùng OpenAI Chat Completions)
# Các lựa chọn thông dụng:
# - OpenAI: https://api.openai.com/v1/chat/completions
# - DeepSeek: https://api.deepseek.com/chat/completions
# - OpenRouter: https://openrouter.ai/api/v1/chat/completions
# - Groq: https://api.groq.com/openai/v1/chat/completions
# - Ollama (local): http://localhost:11434/v1/chat/completions
AI_API_URL=https://api.openai.com/v1/chat/completions

# 3. Model AI sử dụng (ví dụ: gpt-4o-mini, gpt-4o, deepseek-chat, llama-3.3-70b-versatile, ...)
AI_MODEL=gpt-4o-mini

# ===================================================================
# Đấu nối backend (ews-astrolink-api) — BFF, chỉ đọc ở phía server
# ===================================================================
# KHÔNG đặt tên NEXT_PUBLIC_* cho 3 biến dưới: chúng phải ở lại trên server.
# ADMIN_TOKEN lộ ra browser = lộ toàn quyền quản trị.

# DNS nội bộ trên network `ews-net` (xem docker-compose.yml). Chạy `pnpm dev`
# ngoài docker thì dùng http://127.0.0.1:4002
EWS_API_URL=http://ews-astrolink-api:3000

# Trùng với ADMIN_TOKEN của backend. Sinh: openssl rand -hex 32
EWS_ADMIN_TOKEN=

# Org mà console quản trị — GET /admin/apps bắt buộc query `orgId` (uuid).
EWS_ORG_ID=
